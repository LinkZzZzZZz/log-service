###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_random_string
###< symfony/framework-bundle ###

###> rabbitmq ###
RMQ_USER=guest
RMQ_PASS=guest
RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_VHOST=%2f
###< rabbitmq ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://${RMQ_USER}:${RMQ_PASS}@${RMQ_HOST}:${RMQ_PORT}/${RMQ_VHOST}/messages
###< symfony/messenger ###